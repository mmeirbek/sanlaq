[node name="Title" type="Label" parent="Page/Grid/ValueCard/Row/Text"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "04  НЕГЕ МАҢЫЗДЫ?"

[node name="Body" type="Label" parent="Page/Grid/ValueCard/Row/Text"]
layout_mode = 2
text = "Ойын кеңістікте бағдарлауды, жылдам шешім қабылдауды және өзара әрекеттесуді жаттықтырады. Киім атаулары мен тарихы ұлттық мұраны танып-білуге жол ашады."
autowrap_mode = 2
