[ext_resource type="Texture2D" path="res://assets/sprites/modes/role_seeker.png" id="17_tex"]

[node name="About" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_backdrop")
variant = 1
veil = 0.35

[node name="Header" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 32.0
offset_top = 24.0
offset_right = -32.0
offset_bottom = 120.0
grow_horizontal = 2
script = ExtResource("4_header")
title = "САҢЛАҚ ТУРАЛЫ"
subtitle = "ОЙЫН ЕРЕЖЕСІ · МӘДЕНИ МАЗМҰНЫ"

[node name="Page" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = 136.0
offset_right = -32.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2

[node name="IntroPanel" type="PanelContainer" parent="Page"]
layout_mode = 2
theme_type_variation = &"HudPanel"

[node name="Intro" type="Label" parent="Page/IntroPanel"]
layout_mode = 2
text = "Соқыртеке — қуып жету, жасырынып қалу және ұлттық киімді тану арқылы өтетін ойын. Әр матчта рөлді таңдап, қарсыластың әрекетін оқыңыз."
autowrap_mode = 2

[node name="Grid" type="GridContainer" parent="Page"]
layout_mode = 2
size_flags_vertical = 3
columns = 2

[node name="RulesCard" type="PanelContainer" parent="Page/Grid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"Card"

[node name="Row" type="HBoxContainer" parent="Page/Grid/RulesCard"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Icons" type="VBoxContainer" parent="Page/Grid/RulesCard/Row"]
layout_mode = 2
alignment = 1

[node name="Icon0" type="TextureRect" parent="Page/Grid/RulesCard/Row/Icons"]
layout_mode = 2
texture = ExtResource("17_tex")
stretch_mode = 3

[node name="Icon1" type="TextureRect" parent="Page/Grid/RulesCard/Row/Icons"]
layout_mode = 2
texture = ExtResource("16_tex")
stretch_mode = 3

[node name="Text" type="VBoxContainer" parent="Page/Grid/RulesCard/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="Page/Grid/RulesCard/Row/Text"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "01  ОЙЫН ЕРЕЖЕСІ"

[node name="Body" type="Label" parent="Page/Grid/RulesCard/Row/Text"]
layout_mode = 2
text = "Соқыртеке қашушыларды ұстайды. Ұстағаннан кейін киімге қатысты сұраққа дұрыс жауап беру керек. Қашушы уақыт біткенше аман қалса — жеңеді."
autowrap_mode = 2

[node name="EventsCard" type="PanelContainer" parent="Page/Grid"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"Card"

[node name="Row" type="HBoxContainer" parent="Page/Grid/EventsCard"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Icons" type="VBoxContainer" parent="Page/Grid/EventsCard/Row"]
layout_mode = 2
alignment = 1

[node name="Icon0" type="TextureRect" parent="Page/Grid/EventsCard/Row/Icons"]
layout_mode = 2
texture = ExtResource("16_tex")
stretch_mode = 3

[node name="Text" type="VBoxContainer" parent="Page/Grid/EventsCard/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="Page/Grid/EventsCard/Row/Text"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "02  ОЙЫНДАҒЫ ОҚИҒАЛАР"

[node name="Body" type="Label" parent="Page/Grid/EventsCard/Row/Text"]
layout_mode = 2
text = "Қашушы бір рет 3 секунд жүгіре алады. Соқыртекеде бір рет Үн тыңдау бар. Тұман түскенде Соқыртекенің көру аймағы азаяды."
autowrap_mode = 2

