text = "03  КИІМ ҚАСИЕТТЕРІ"

[node name="Body" type="Label" parent="Page/Grid/ClothesCard/Row/Text"]
layout_mode = 2
text = "Тымақ баяулау уақытын 30% қысқартады. Шапан қарсыласқа азырақ көрінуге көмектеседі. Саптама етік құрғақ жерде жылдамдықты 8% арттырады."
autowrap_mode = 2

