[node name="Text" type="Label" parent="Page/Margin/VBox/RowOne/RulesCard/Margin/VBox"]
layout_mode = 2
text = "Соқыртеке қашушыларды ұстайды. Ұстағаннан кейін киімге қатысты сұраққа дұрыс жауап беру керек. Қашушы уақыт біткенше аман қалса — жеңеді."
autowrap_mode = 2
theme_override_font_sizes/font_size = 15

