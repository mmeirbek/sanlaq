; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="САҢЛАҚ / Sañlaq"
config/description="САҢЛАҚ — казахская игра в ловца «соқыртеке»: соревновательная погоня-прятки с изучением национальной одежды."
config/version="0.2.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/ui/sanlaq_logo.png"

[audio]

; Нужно для запасного варианта озвучки брифинга: если записанного файла нет,
; строку читает системный синтезатор речи (см. scripts/systems/narration.gd).
general/text_to_speech=true

[autoload]

AssetRegistry="*res://autoload/asset_registry.gd"
SaveManager="*res://autoload/save_manager.gd"
GameSettings="*res://autoload/game_settings.gd"
MusicAudio="*res://autoload/music_audio.gd"
SceneRouter="*res://autoload/scene_router.gd"
Telemetry="*res://autoload/telemetry.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/custom="res://resources/ui/sanlaq_theme.tres"

[importer_defaults]

; Озвучка брифингов синтезируется утилитой `say`, а она оставляет тишину в
; начале и в конце. Обрезаем её при импорте, чтобы строки читались подряд без
; провалов. Настройка живёт здесь, а не в .import: те не коммитятся.
wav={
"edit/trim": true
}

