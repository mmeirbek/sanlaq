class_name RunContext
## Как запущена игра.
##
## Headless-запуск — это автотесты и CI: живого игрока нет. В нём игра не
## трогает сохранение игрока и не шлёт телеметрию. Иначе прогон тестов на
## машине разработчика портил бы его профиль, а каждый прогон CI выглядел бы
## на сервере как новая станция.


static func is_headless() -> bool:
	return DisplayServer.get_name() == "headless"
