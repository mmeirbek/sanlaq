[resource]
script = ExtResource("1")
id = "tusaukeser"
question = "Тұсаукесер қашан жасалады?"
options = Array[String](["Бала алғаш қадам басқанда", "Үйленгенде", "Туған күнде"])
correct = 0
fact = "Баланың тұсауын кеседі — жүрісі жеңіл, жолы ашық болсын деген тілекпен."
