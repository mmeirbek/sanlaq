[resource]
script = ExtResource("1")
id = "shanyraq"
question = "Киіз үйдің төбесіндегі шеңбер қалай аталады?"
options = Array[String](["Шаңырақ", "Уық", "Кереге"])
correct = 0
fact = "Шаңырақ — отбасы мен әулет белгісі, Қазақстан елтаңбасында бейнеленген."
