[sub_resource type="Resource" id="StoryDialogue_42"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_ENVOY_W"
speaker = "Кіші жүз елшісі"
look = "envoy"
lines = Array[String](["Сұлтан, біздің ауылдар жайылым үшін көршілерімен дауласып жүр.", "Әділ төрелік айтсаңыз, ел сізге құлақ асады."])
choices = Array[ExtResource("5_story_choice")]([SubResource("StoryChoice_40"), SubResource("StoryChoice_41")])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_43"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_ENVOY_W_FAIR"
speaker = "Кіші жүз елшісі"
look = "envoy"
lines = Array[String](["Бұл — бидің де, ханның да жолы. Біз бірлікке қосыламыз."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_44"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_ENVOY_W_FORCE"
speaker = "Кіші жүз елшісі"
look = "envoy"
lines = Array[String](["Күшпен тоқтатылған дау кейін қайта өршиді... Бірақ бұйрығыңызды жеткіземін."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

