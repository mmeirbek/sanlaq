[sub_resource type="Resource" id="StoryDialogue_37"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_BI"
speaker = "Би"
look = "bi"
lines = Array[String](["Абылай сұлтан, жоңғар қаупі әлі сейілген жоқ. Шекарада шапқыншылар жиі көрінеді.", "Қолда жасақ бар. Бірақ ел бытыраңқы — әр жүз өз қамымен жүр.", "Қалай істейміз: бірінші болып соққы береміз бе, әлде күшімізді біріктіреміз бе?"])
choices = Array[ExtResource("5_story_choice")]([SubResource("StoryChoice_35"), SubResource("StoryChoice_36")])
check_note = "[ПРОВЕРИТЬ] обстановка перед избранием Абылая ханом"

[sub_resource type="Resource" id="StoryDialogue_38"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_BI_STRIKE"
speaker = "Би"
look = "bi"
lines = Array[String](["Жүрек батыл. Бірақ жалғыз қолдан шапалақ шықпас — алдымен елшілерді тыңдаңыз."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_39"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_BI_UNITE"
speaker = "Би"
look = "bi"
lines = Array[String](["Дұрыс шешім. Үш жүздің басы қосылса, жау алмайтын қамал жоқ. Елшілер сізді күтіп тұр."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryChoice_40"]
script = ExtResource("5_story_choice")
label = "Екі жақты да тыңдап, әділ бітім айтамын"
next_dialogue = "DIA_A_ENVOY_W_FAIR"
flag = "fair"
xp = 20
unity = 30

