[sub_resource type="Resource" id="StoryDialogue_47"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_ENVOY_S"
speaker = "Ұлы жүз елшісі"
look = "envoy2"
lines = Array[String](["Оңтүстікте керуен жолы қауіпті. Түркістан маңы тыныш болуы керек.", "Біз сізден қолдау күтеміз."])
choices = Array[ExtResource("5_story_choice")]([SubResource("StoryChoice_45"), SubResource("StoryChoice_46")])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_48"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_ENVOY_S_GUARD"
speaker = "Ұлы жүз елшісі"
look = "envoy2"
lines = Array[String](["Рақмет. Батырлар жолды күзетсе, керуен де, ел де тынады."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_49"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_ENVOY_S_COUNCIL"
speaker = "Ұлы жүз елшісі"
look = "envoy2"
lines = Array[String](["Кеңесті ел азбайды. Түркістандағы жиында кездесеміз."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_50"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_HERDER"
speaker = "Малшы"
look = "resident"
lines = Array[String](["Елшінің аты бос жүр, сұлтаным.", "Атты бағанаға дейін жетелеп апарыңызшы — соңыңыздан ереді."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_51"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_BAIGE"
speaker = "Малшы"
look = "resident"
lines = Array[String](["Жиын алдында бәйге бар, сұлтаным. Ауыл жігіті сізбен жарысқысы келеді.", "Бес белгіні ретімен алып, мәреге бірінші жетсеңіз — жеңіс сіздікі."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_52"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_CHILDREN"
speaker = "Балалар"
look = "child"
lines = Array[String](["Сұлтан аға, сақаңызды алыңыз! Асық атып көрейік.", "Бес рет атасыз. Үш асықты шеңберден шығарсаңыз — жеңіс сіздікі!"])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_53"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_ELDER"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Ертең ұзақ жол. Бүгін от басында отырып, бабалар сөзін тыңдайық."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_54"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_T1"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["1723 жылы жоңғарлар кенеттен шабуыл жасады. Ел ауыр күйге түсті.", "Халық ол жылдарды «Ақтабан шұбырынды» деп атады."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] 1723 год и название «Ақтабан шұбырынды»"

[sub_resource type="Resource" id="StoryDialogue_55"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_T2"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Құрметті кісіге шапан жабу — ізет пен сыйдың белгісі.", "Шапанның сәні де, жылуы да — шеберінің қолында."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] обычай «шапан жабу»"

[sub_resource type="Resource" id="StoryDialogue_56"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_T4"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Ауыр жылдары ел жаппай босыпты.", "Халық ол кезеңді «Ақтабан шұбырынды» деп атаған."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] происхождение выражения"

[sub_resource type="Resource" id="StoryDialogue_57"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_T5"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Хан сайлауда ел өкілдері жиналады.", "Жаңа ханды ақ киізге көтеріп, жұртқа таныстырады."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] обряд поднятия на белой кошме"

[sub_resource type="Resource" id="StoryDialogue_58"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_T3"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Асық — ауыл баласының сүйікті ойыны.", "Сақаны дәл ату үшін көз де, шыдам да керек."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_59"]
script = ExtResource("6_story_dialogue")
id = "DIA_A_ROUTE"
speaker = "Би"
look = "bi"
lines = Array[String](["Қала қақпасы ашық, үш жүздің өкілдері жиналып қалды.", "Ел алдына шығатын уақыт жетті."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] место избрания — Түркістан"

[resource]
script = ExtResource("7_story_chapter")
id = "CH_ABYLAI"
hero = "ROLE_ABYLAI"
title = "II тарау · Бірлік"
subtitle = "XVIII ғасыр"
intro = "Жоңғар шапқыншылығы елді әлсіретті. Абылай сұлтан үш жүздің басын қосып, ел бірлігін нығайтуы керек."
finale_title = "II ТАРАУ АЯҚТАЛДЫ"
finale_text = "Түркістанда ел жиналды. Дәстүр бойынша Абылайды ақ киізге көтеріп, хан сайлады."
finale_alt_text = "Түркістанда үш жүздің өкілдері бір дастарқанға жиналды. Бірлікті таңдаған Абылайды ел ақ киізге көтеріп, хан сайлады."
finale_alt_min_unity = 60
ally_min_unity = 50
ally_message = "Кіші жүз бен Ұлы жүз жасағы келді"
duel_ally_min_unity = 50
