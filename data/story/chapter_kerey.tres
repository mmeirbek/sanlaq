[sub_resource type="Resource" id="StoryDialogue_31"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_BI"
speaker = "Би"
look = "bi"
lines = Array[String](["Керей сұлтан, Әбілқайыр ордасында тыныштық жоқ. Көп ауыл ауа көшуге бел буды.", "Жәнібек сұлтан да осы ойда. Шу бойында, Жетісуда жер кең, жайылым мол.", "Ел сіздің шешіміңізді күтіп отыр. Не айтасыз?"])
choices = Array[ExtResource("5_story_choice")]([SubResource("StoryChoice_29"), SubResource("StoryChoice_30")])
check_note = "[ПРОВЕРИТЬ] откочёвка от Абулхаира к Жетысу — сверить с учебником «Қазақстан тарихы»"

[sub_resource type="Resource" id="StoryDialogue_32"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_BI_GO"
speaker = "Би"
look = "bi"
lines = Array[String](["Батыл шешім. Бірақ қарт пен баланы ұмытпаңыз — көш солардың қарқынымен жүреді."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_33"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_BI_LISTEN"
speaker = "Би"
look = "bi"
lines = Array[String](["Дана сөз. Елдің келісімі — көштің берік қазығы. Айша дайындықты бастап қойды."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_34"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_AISHA"
speaker = "Айша"
look = "woman"
lines = Array[String](["Көш алдында от жағамыз, бірақ отын жетпей тұр.", "Ауыл маңынан төрт бума отын жинап әкелші."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_35"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_AISHA_DONE"
speaker = "Айша"
look = "woman"
lines = Array[String](["Отын жетеді, рақмет. Қазан асылады.", "Енді малшыға көмектес: жаңа қонысқа киіз үй тігу керек."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_36"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_HERDER"
speaker = "Малшы"
look = "resident"
lines = Array[String](["Киіз үйдің бөліктері шашылып жатыр: кереге, уық, шаңырақ, киіз.", "Ретімен әкел: алдымен кереге, сосын уық, шаңырақ, ең соңында киіз."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_37"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_CHILDREN"
speaker = "Балалар"
look = "child"
lines = Array[String](["Сұлтан аға, көш алдында бізбен ойнаңызшы!", "Сіз «теке» боласыз: көзіңізді байлаймыз, ал біз шапалақ соғамыз!"])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_38"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_ELDER"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Көш алдындағы соңғы түн. Отқа жақын отырыңыз, әңгіме айтайын."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_39"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_T1"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Әбілқайыр хан тұсында ру басылары арасында алауыздық көбейді.", "Елдің бір бөлігі Керей мен Жәнібекке еріп, Моғолстан шекарасына қарай көшті.", "Осы көш Қазақ хандығының бастауы болды деп айтылады."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] причины откочёвки и её направление"

[sub_resource type="Resource" id="StoryDialogue_40"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_T2"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Жетісу — жеті өзеннің өлкесі. Тауы биік, жайлауы шүйгін.", "Шу мен Талас бойында малға да жер жетеді."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_41"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_T4"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Ұлытау — даланың кіндігі саналады.", "Ол жақта көне қорымдар мен кесенелер бар."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] памятники Улытау"

[sub_resource type="Resource" id="StoryDialogue_42"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_T3"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Соқыр теке — баланың құлағын, сезімін шыңдайтын ойын.", "Көзі байлаулы бала дыбысқа қарап жол табады."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_43"]
script = ExtResource("6_story_dialogue")
id = "DIA_K_ROUTE"
speaker = "Би"
look = "bi"
lines = Array[String](["Ауыл далаға шықты, жүк артылды.", "Көш бағыты — Шу бойы, Қозыбасы."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] Қозыбасы как место откочёвки"

[resource]
script = ExtResource("7_story_chapter")
id = "CH_KEREY"
hero = "ROLE_KEREY"
title = "I тарау · Көш"
subtitle = "XV ғасыр"
intro = "Әбілқайыр ордасында алауыздық күшейді. Керей мен Жәнібек сұлтандар елді жаңа қонысқа бастауға бел буды."
finale_title = "I ТАРАУ АЯҚТАЛДЫ"
finale_text = "Көш Жетісуға аман жетті. Жаңа қонысқа орныққан ел кейін Қазақ хандығы деген атпен тарихта қалды."
finale_alt_text = "Көш Жетісуға аман жетті. Елдің ойын тыңдаған сұлтанға халық сенді — жаңа қоныста Қазақ хандығының іргетасы қаланды."
finale_alt_min_unity = 20
ally_min_unity = 20
ally_message = "Көрші ауыл да көшке қосылды"
duel_ally_min_unity = 0
beats = Array[ExtResource("1_story_beat")]([SubResource("StoryBeat_1"), SubResource("StoryBeat_3"), SubResource("StoryBeat_4"), SubResource("StoryBeat_6"), SubResource("StoryBeat_7"), SubResource("StoryBeat_12"), SubResource("StoryBeat_13")])
placements = Array[ExtResource("4_story_placement")]([SubResource("StoryPlacement_14"), SubResource("StoryPlacement_15"), SubResource("StoryPlacement_16"), SubResource("StoryPlacement_17"), SubResource("StoryPlacement_18"), SubResource("StoryPlacement_19"), SubResource("StoryPlacement_20"), SubResource("StoryPlacement_21"), SubResource("StoryPlacement_22"), SubResource("StoryPlacement_23"), SubResource("StoryPlacement_24"), SubResource("StoryPlacement_25")])
allies = Array[ExtResource("4_story_placement")]([SubResource("StoryPlacement_26"), SubResource("StoryPlacement_27"), SubResource("StoryPlacement_28")])
dialogues = Array[ExtResource("6_story_dialogue")]([SubResource("StoryDialogue_31"), SubResource("StoryDialogue_32"), SubResource("StoryDialogue_33"), SubResource("StoryDialogue_34"), SubResource("StoryDialogue_35"), SubResource("StoryDialogue_36"), SubResource("StoryDialogue_37"), SubResource("StoryDialogue_38"), SubResource("StoryDialogue_39"), SubResource("StoryDialogue_40"), SubResource("StoryDialogue_41"), SubResource("StoryDialogue_42"), SubResource("StoryDialogue_43")])
