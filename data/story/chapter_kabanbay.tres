[sub_resource type="Resource" id="StoryDialogue_31"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_COUNCIL"
speaker = "Жүзбасы"
look = "warrior"
lines = Array[String](["Батыр, барлаушылар хабар әкелді: жау қолы асудан өтуге дайындалып жатыр.", "Жасақ дайын. Бұйрығыңызды күтеміз."])
choices = Array[ExtResource("5_story_choice")]([SubResource("StoryChoice_29"), SubResource("StoryChoice_30")])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_32"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_FORTIFY"
speaker = "Жүзбасы"
look = "warrior"
lines = Array[String](["Құп болады! Барлық жасақ бір тудың астына жиналады.", "Жекпе-жекке шыққанда артыңда жасақтас тұрады. Алдымен ұстаға соғып, қаруыңызды алыңыз."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_33"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_AMBUSH"
speaker = "Жүзбасы"
look = "warrior"
lines = Array[String](["Құп болады! Жасақты екіге бөлеміз, сайға тосқауыл қоямыз.", "Бірақ жекпе-жекке жалғыз шығасыз. Алдымен ұстаға соғып, қаруыңызды алыңыз."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_34"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_SMITH"
speaker = "Ұста"
look = "resident"
lines = Array[String](["Сауытыңыз жөнделді, найзаңыз қайралды.", "Мына шапанды да алыңыз — таулы жерде түн суық."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_35"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_SCOUT_TRACK"
speaker = "Барлаушы"
look = "envoy"
lines = Array[String](["Батыс жақтағы тастардың арасынан жау ізі көрінді.", "Барып өз көзіңмен қара — біз мұнда күземіз."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_36"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_AISHA"
speaker = "Айша"
look = "woman"
lines = Array[String](["Ана мен бала таудағы жасырын жайлауға көшті.", "Ауыл сізге сенеді, батыр. Аман оралыңыз."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_37"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_SCOUT"
speaker = "Барлаушы"
look = "envoy"
lines = Array[String](["Жау батыры екі қолдың алдына шығып, жекпе-жекке шақырды!", "Ата дәстүр бойынша ұрыс жекпе-жектен басталады."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_38"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_ELDER"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Жеңіспен оралдың, батыр. Отқа жақын кел."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_39"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_T1"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Бұланты мен Аңырақай шайқастарында қазақ жасақтары бірігіп соғысты.", "Бұл жеңістер елдің рухын көтерді."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] битвы при Бұланты и Аңырақай, их даты"

[sub_resource type="Resource" id="StoryDialogue_40"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_T2"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Батыр — ел қорғаны.", "Оның күші тек білегінде емес, елге деген адалдығында."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = ""

[sub_resource type="Resource" id="StoryDialogue_41"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_T4"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Аңырақай — Балқаштың оңтүстігіндегі дала.", "Сол жердегі шайқаста үш жүздің жасағы бірге қимылдаған."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] дата и место Аңырақай"

[sub_resource type="Resource" id="StoryDialogue_42"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_T5"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Қанжығалы Бөгенбай да сол замандағы қолбасшы.", "Ел оның атын Қабанбаймен қатар атайды."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] годы жизни Бөгенбая"

[sub_resource type="Resource" id="StoryDialogue_43"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_T3"
speaker = "Ақсақал"
look = "elder"
lines = Array[String](["Жеңіспен оралған батырға шапан жабады.", "Бұл — ел алғысының белгісі."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] обычай «шапан жабу» для батыра"

[sub_resource type="Resource" id="StoryDialogue_44"]
script = ExtResource("6_story_dialogue")
id = "DIA_B_ROUTE"
speaker = "Жүзбасы"
look = "warrior"
lines = Array[String](["Жасақтар бірігіп жатыр. Келесі жиын — Аңырақай даласында."])
choices = Array[ExtResource("5_story_choice")]([])
check_note = "[ПРОВЕРИТЬ] место сбора — Аңырақай"

[resource]
script = ExtResource("7_story_chapter")
id = "CH_KABANBAY"
hero = "ROLE_KABANBAY"
title = "III тарау · Қорғаныс"
subtitle = "XVIII ғасыр"
intro = "Жау қолы шекараға жақындады. Қабанбай батыр жасақты бастап, елді қорғауға аттанады."
finale_title = "III ТАРАУ АЯҚТАЛДЫ"
finale_text = "Біріккен қазақ жасақтары жауға тойтарыс берді. Аңырақай даласындағы жеңіс халық жадында сақталды."
finale_alt_text = "Бір тудың астына жиналған жасақ жауды тойтарды. Аңырақай даласындағы жеңісте әр рудың үлесі болды."
finale_alt_min_unity = 40
ally_min_unity = 40
ally_message = "Жасақ бір тудың астына жиналды"
duel_ally_min_unity = 40
beats = Array[ExtResource("1_story_beat")]([SubResource("StoryBeat_1"), SubResource("StoryBeat_2"), SubResource("StoryBeat_4"), SubResource("StoryBeat_5"), SubResource("StoryBeat_6"), SubResource("StoryBeat_11"), SubResource("StoryBeat_12")])
placements = Array[ExtResource("4_story_placement")]([SubResource("StoryPlacement_13"), SubResource("StoryPlacement_14"), SubResource("StoryPlacement_15"), SubResource("StoryPlacement_16"), SubResource("StoryPlacement_17"), SubResource("StoryPlacement_18"), SubResource("StoryPlacement_19"), SubResource("StoryPlacement_20"), SubResource("StoryPlacement_21"), SubResource("StoryPlacement_22"), SubResource("StoryPlacement_23"), SubResource("StoryPlacement_24"), SubResource("StoryPlacement_25")])
allies = Array[ExtResource("4_story_placement")]([SubResource("StoryPlacement_26"), SubResource("StoryPlacement_27"), SubResource("StoryPlacement_28")])
dialogues = Array[ExtResource("6_story_dialogue")]([SubResource("StoryDialogue_31"), SubResource("StoryDialogue_32"), SubResource("StoryDialogue_33"), SubResource("StoryDialogue_34"), SubResource("StoryDialogue_35"), SubResource("StoryDialogue_36"), SubResource("StoryDialogue_37"), SubResource("StoryDialogue_38"), SubResource("StoryDialogue_39"), SubResource("StoryDialogue_40"), SubResource("StoryDialogue_41"), SubResource("StoryDialogue_42"), SubResource("StoryDialogue_43"), SubResource("StoryDialogue_44")])
