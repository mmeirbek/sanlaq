[gd_resource type="Resource" script_class="ModeBriefing" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/core/mode_briefing.gd" id="1"]

[resource]
script = ExtResource("1")
id = "sokyroteke"
kicker = "ҚУУ ОЙЫНЫ"
title = "Соқыртеке"
how_to_play = Array[String]([
"Соқыртекенің көзі байлаулы: жарық шеңберінен тыс қашушыларды көрмейді, тек дыбысты естиді.",
"Қашушыны қуып жетіп ұстаңыз. Ұстаған сәтте оның үстіндегі киімді суреттен тану керек.",
"Дұрыс жауап — ойыншы ойыннан шығады, ал сол киім гардеробтан ашылады. Қате жауап — бес секунд баяулау.",
"Су бәрін баяулатады, киіз үй ішіне кіріп жасырынуға болады. Тоқсан секунд ішінде бәрін ұстаңыз."
])
skills = Array[String]([
"Ұлттық киім атауларын танып, есте сақтауға үйретеді.",
"Кеңістікте бағдарлау мен жылдам шешім қабылдауды жаттықтырады.",
"Мұқият тыңдап, байқағыштықты дамытады."
])
backdrop = 0
