[gd_resource type="Resource" script_class="ModeBriefing" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/core/mode_briefing.gd" id="1"]

[resource]
script = ExtResource("1")
id = "abai_says"
kicker = "ЖАДЫ ОЙЫНЫ"
title = "Абай айтады"
how_to_play = Array[String]([
"Абай тағам карточкаларын бір-бірлеп жандырып, тізбек көрсетеді. Мұқият қараңыз.",
"Сол тізбекті дәл сол ретпен қайталаңыз: карточкаларды кезегімен басасыз.",
"Әр раундта тізбек бір карточкаға ұзарады, сондықтан есте сақтау қиындай береді.",
"Құрылғыны кезекпен беріңіз. Бір раундта қателескендер раунд соңында бірге шығады."
])
skills = Array[String]([
"Ұлттық тағам атауларын танып, есте сақтауға үйретеді.",
"Қысқа мерзімді жады мен зейінді жаттықтырады.",
"Кезекті күтіп, бірге ойнау мәдениетін қалыптастырады."
])
backdrop = 5
