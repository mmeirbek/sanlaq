[ext_resource type="Script" path="res://scripts/core/mode_briefing.gd" id="1"]

[resource]
script = ExtResource("1")
id = "togyz_qumalaq"
kicker = "ТАҚТА ОЙЫНЫ"
title = "Тоғыз құмалақ"
how_to_play = Array[String]([
"Әр отауда тоғыз құмалақтан. Өз отауыңызды таңдап, ішінде бір құмалақ қалдырып, қалғанын сағат тіліне қарсы таратасыз.",
"Соңғы құмалақ қарсыластың отауына түсіп, ондағы сан жұп болса, сол отаудағы бүкіл құмалақ қазаныңызға кетеді.",
"Егер сол отауда дәл үш құмалақ болса, оны тұздық етіп аласыз. Тұздық әр ойыншыда біреу ғана, тоғызыншы отау тұздық бола алмайды.",
"Қазанына сексен екі құмалақ жинаған ойыншы жеңеді."
])
skills = Array[String]([
"Санауды және бірнеше жүріс алдын ала есептеуді үйретеді.",
"Стратегиялық ойлау мен шыдамдылықты дамытады.",
"Ұлттық логикалық ойын дәстүрімен таныстырады."
])
backdrop = 6
