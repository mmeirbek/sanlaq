[gd_resource type="Resource" script_class="ModeBriefing" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/core/mode_briefing.gd" id="1"]

[resource]
script = ExtResource("1")
id = "aq_suyek"
kicker = "ТҮНГІ ОЙЫН"
title = "Ақ сүйек"
how_to_play = Array[String]([
"Екі топ — Көк пен Қызыл, әр топтың өз көмбесі бар. Ақ сүйек түнгі далаға лақтырылады.",
"Раунд алдында дәстүр туралы сұраққа жауап бересіз: дұрыс жауап берсеңіз, сүйектің қайда түскенін көресіз.",
"Іздеуші сүйекті өз көмбесіне алып жүгіреді. Қарсылас оны тиіп тартып алады, қорғаушы 2 секундқа тоқтатады.",
"Сүйекті өз көмбесіне жеткізген топ ұпай алады. Үш раундтың екеуін ұтқан топ жеңеді."
])
skills = Array[String]([
"Қазақ салт-дәстүрі туралы білімді еске түсіріп, бекітеді.",
"Топпен бірге әрекет етуге және рөл бөлісуге үйретеді.",
"Жылдамдық пен кеңістікте бағдарлауды дамытады."
])
