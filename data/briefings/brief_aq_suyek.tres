[ext_resource type="Script" path="res://scripts/core/mode_briefing.gd" id="1"]

[resource]
script = ExtResource("1")
id = "aq_suyek"
kicker = "ТҮНГІ ОЙЫН"
title = "Ақ сүйек"
how_to_play = Array[String]([
"Түнгі далада бір отауға ақ сүйек жасырылған. Қайда екенін ешкім білмейді.",
"Жүру үшін қадам керек, ал қадамды дәстүр туралы сұраққа жауап бергенде аласыз: дұрыс жауап үш қадам, қате жауап бір қадам береді.",
"Әр қадамда көрші отауға өтесіз, ол отау сүйекке қаншалық жақын екенін айтады: өте жақын, жақын, алыс емес немесе алыс.",
"Сүйекті бірінші тапқан раундты ұтады. Үш раундтың екеуін ұтқан ойыншы жеңеді."
])
skills = Array[String]([
"Қазақ салт-дәстүрі туралы білімді еске түсіріп, бекітеді.",
"Кеңістікте бағдарлау мен болжам жасауды үйретеді.",
"Аз қадаммен мақсатқа жетуді жоспарлауға жаттықтырады."
])
backdrop = 7
